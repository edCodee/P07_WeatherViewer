<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="@dimen/list_item_padding"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="@dimen/list_item_padding">

    <!-- Decorativo: la descripcion del clima ya esta en dayTextView -->
    <ImageView
        android:id="@+id/conditionImageView"
        android:layout_width="@dimen/image_side_length"
        android:layout_height="@dimen/image_side_length"
        android:layout_gravity="center_vertical"
        android:background="@drawable/icon_background"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <!-- PDF 7.4.7 paso 3: 3 columnas x 2 filas, ocupa el resto del ancho -->
    <GridLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:columnCount="3"
        android:rowCount="2"
        android:useDefaultMargins="true">

        <TextView
            android:id="@+id/dayTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_columnSpan="3"
            android:layout_gravity="fill_horizontal"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            tools:text="Thursday: overcast clouds" />

        <TextView
            android:id="@+id/lowTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="Low: 11°C" />

        <TextView
            android:id="@+id/hiTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="High: 22°C" />

        <TextView
            android:id="@+id/humidityTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="Humidity: 65%" />
    </GridLayout>
</LinearLayout>